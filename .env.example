DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@127.0.0.1:3306/video2quiz?charset=utf8mb4
VIDEO2QUIZ_DATA_DIR=./data
MAX_UPLOAD_MB=500
WHISPER_MODEL=base

# Free cloud PostgreSQL alternative (Neon); keep sslmode=require.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/video2quiz?sslmode=require

# Quiz limits and optional free local AI provider
MAX_QUIZ_QUESTIONS=60
MAX_GENERATION_JOBS=2
OLLAMA_MODEL=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT_SECONDS=300
MAX_GENERATION_TRANSCRIPT_CHARS=60000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set to 1 only for a single-worker deployment to mark interrupted jobs on restart.
RECOVER_GENERATION_JOBS=0
# Optional private S3-compatible durable storage. Keep blank for local disk.
MEDIA_BUCKET=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Allowlisted HTTPS hosts for pre-existing cloud media URLs, if used.
CLOUD_MEDIA_HOSTS=
